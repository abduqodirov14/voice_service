# env files
.env*
/frontend/.env*

# Python
/.venv/
__pycache__/
*.pyc
/voice_service/__pycache__/
/voice_service/voice_cache/
/voice_service/temp_audio/

# vercel
.vercel
/frontend/.vercel/

# typescript
*.tsbuildinfo
